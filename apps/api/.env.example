# ── Server ──
NODE_ENV=development
PORT=3000

# ── CORS ──
# Comma-separated list of allowed origins. Never use "*".
CORS_ORIGINS=http://localhost:5173

# ── Supabase (SERVER ONLY — never prefix with VITE_) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVER ONLY — never prefix with VITE_. Full read/write, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME -> # Authentication Secret
SUPABASE_STORAGE_BUCKET=product-images
# Optional. The `iss` claim required on user JWTs; defaults to
# ${SUPABASE_URL}/auth/v1. Only set this when the API reaches Supabase on a
# different URL than the browser used to sign in (e.g. Docker: API uses
# host.docker.internal, tokens say http://127.0.0.1:54321/auth/v1).
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# ── OpenAI (SERVER ONLY — never prefix with VITE_) ──
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL_GENERATION=gpt-4.1-mini
OPENAI_MODEL_SEARCH=gpt-4.1-mini
OPENAI_MODEL_IMAGE=gpt-image-1

# ── AI cost controls ──
AI_DAILY_QUOTA=200

# ── Logging ──
LOG_LEVEL=info
# Never set true in production — logs raw prompts.
AI_LOG_PROMPTS=false
