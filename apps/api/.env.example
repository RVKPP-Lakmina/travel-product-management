# ── Server ──
NODE_ENV=development
PORT=3000

# ── CORS ──
# Comma-separated list of allowed origins. Never use "*".
CORS_ORIGINS=http://localhost:5173

# ── Supabase (SERVER ONLY — never prefix with VITE_) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVER ONLY — never prefix with VITE_. Full read/write, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=product-images

# ── OpenAI (SERVER ONLY — never prefix with VITE_) ──
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL_GENERATION=gpt-4.1-mini
OPENAI_MODEL_SEARCH=gpt-4.1-mini
OPENAI_MODEL_IMAGE=gpt-image-1

# ── AI cost controls ──
AI_DAILY_QUOTA=200

# ── Logging ──
LOG_LEVEL=info
# Never set true in production — logs raw prompts.
AI_LOG_PROMPTS=false
