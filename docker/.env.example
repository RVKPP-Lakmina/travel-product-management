# Docker Compose auto-loads a ".env" file sitting next to whichever
# compose file you pass with -f — this is what supplies build-time
# ${VARIABLE} interpolation in docker/compose.prod.yml (e.g. the
# VITE_SUPABASE_PUBLISHABLE_KEY build arg). It is NOT the same as
# apps/api/.env or apps/web/.env, which are loaded at container
# RUNTIME via each service's env_file: directive, not at build time.
#
# Copy this to docker/.env and fill in the real value:
#   cp docker/.env.example docker/.env

# Public by design — see apps/web/.env.example for why. Only needed here
# because Vite bakes it into the JS bundle at BUILD time, and compose's
# build.args interpolation only reads the shell environment or this file.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional overrides — defaults in docker/compose.prod.yml already point
# at a local `supabase start` stack. Only set these if pointing the stack
# at a different Supabase project.
# API_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# WEB_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
