{
  "name": "travel-product-management",
  "private": true,
  "scripts": {
    "setup": "pnpm install && turbo run build --filter=@travel/validation",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check": "turbo run lint check-types test build",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "docker:dev": "node scripts/docker-up.mjs dev",
    "docker:dev:down": "docker compose -f docker/compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker/compose.dev.yml logs -f",
    "docker:prod": "node scripts/docker-up.mjs prod",
    "docker:prod:down": "docker compose -f docker/compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker/compose.prod.yml logs -f"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
